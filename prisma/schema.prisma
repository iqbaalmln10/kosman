datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-id"
}

// Model untuk Owner (User)
model User {
  id         String     @id @default(uuid())
  email      String     @unique
  name       String?
  properties Property[] // Satu owner bisa punya banyak properti/kos
  createdAt  DateTime   @default(now())
}

// Model untuk Properti (Nama Kos)
model Property {
  id        String   @id @default(uuid())
  name      String   // Contoh: "Kos Melati"
  address   String
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id])
  rooms     Room[]   // Satu kos punya banyak kamar
  createdAt DateTime @default(now())
}

// Model untuk Kamar
model Room {
  id         String   @id @default(uuid())
  number     String   // Contoh: "A1" atau "101"
  price      Float
  status     String   @default("AVAILABLE") // AVAILABLE, OCCUPIED, REPAIR
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])
  tenants    Tenant[]
}

// Model untuk Penghuni
model Tenant {
  id        String   @id @default(uuid())
  name      String
  phone     String
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id])
  startDate DateTime @default(now())
}