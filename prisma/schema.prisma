generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model properties {
  id          String   @id @default(cuid())
  name        String
  address     String
  city        String?
  description String?
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  users       users    @relation(fields: [userId], references: [id], onDelete: Cascade)
  rooms       rooms[]

  @@index([userId])
}

model rooms {
  id          String     @id
  roomNumber  String
  price       Int
  status      RoomStatus @default(AVAILABLE)
  description String?
  propertyId  String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime
  properties  properties @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenants     tenants?

  @@index([propertyId])
  @@index([status])
}

model tenants {
  id           String         @id
  fullName     String
  email        String?
  phone        String
  idCardUrl    String?
  moveInDate   DateTime
  dueDate      Int
  roomId       String         @unique
  createdAt    DateTime       @default(now())
  updatedAt    DateTime
  rooms        rooms          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  transactions transactions[]

  @@index([phone])
  @@index([roomId])
}

model transactions {
  id            String            @id
  amount        Int
  month         String
  status        TransactionStatus @default(PENDING)
  paidAt        DateTime?
  paymentMethod String?
  tenantId      String
  createdAt     DateTime          @default(now())
  updatedAt     DateTime
  tenants       tenants           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([month])
  @@index([status])
  @@index([tenantId])
}

model users {
  id         String       @id @default(cuid()) // Tambahkan default
  clerkId    String       @unique
  email      String       @unique
  firstName  String?
  lastName   String?
  imageUrl   String?
  phone      String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt // Tambahkan @updatedAt otomatis
  properties properties[]

  @@index([clerkId])
  @@index([email])
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
}

enum TransactionStatus {
  PENDING
  PAID
  OVERDUE
}
